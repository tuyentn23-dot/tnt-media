# TNT Media Environment Configuration
# Copy this file to .env and fill in your values

# YouTube API Credentials
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here

# TikTok API Credentials
TIKTOK_API_KEY=your_tiktok_api_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here

# Database
DATABASE_URL=sqlite:///tnt_media.db

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/tnt_media.log

# Content Settings
DEFAULT_BPM=120
DEFAULT_ROOT_NOTE=A3
DEFAULT_SCALE=dorian
DEFAULT_BARS=16

# Publishing
AUTO_PUBLISH=false
MAX_DAILY_PUBLISH=3
PUBLISH_INTERVAL_HOURS=8
