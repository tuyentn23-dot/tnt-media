QWidget{background:#1C1C1E;color:#F2F2F7;font-family:'Segoe UI',sans-serif;font-size:13px}
QMainWindow,QDialog{background:#1C1C1E}
#Sidebar{background:#161618;border-right:1px solid #2C2C2E}
#Sidebar QPushButton{background:transparent;border:none;text-align:left;padding:9px 14px;border-radius:8px;color:#C7C7CC;font-size:13px}
#Sidebar QPushButton:hover{background:#2C2C2E}
#Sidebar QPushButton:checked{background:#0A84FF;color:#FFFFFF;font-weight:600}
#TopBar{background:#2C2C2E;border-bottom:1px solid #3A3A3C}
#Card{background:#2C2C2E;border:1px solid #3A3A3C;border-radius:12px}
#CardTitle{font-size:12px;color:#98989D;font-weight:600}
#CardValue{font-size:26px;color:#FFFFFF;font-weight:700}
#PageTitle{font-size:22px;font-weight:700;color:#FFFFFF}
#PageSub{font-size:12px;color:#98989D}
QPushButton{border-radius:8px;padding:7px 14px;background:#3A3A3C;border:1px solid #48484A;color:#F2F2F7}
QPushButton:hover{background:#48484A}
QPushButton#Primary{background:#0A84FF;color:#FFFFFF;border:none;font-weight:600}
QPushButton#Primary:hover{background:#3395FF}
QPushButton#Danger{background:#FF453A;color:#FFFFFF;border:none}
QTableWidget,QTreeWidget{background:#2C2C2E;border:1px solid #3A3A3C;border-radius:10px;gridline-color:#3A3A3C;selection-background-color:#0A4C99;selection-color:#FFFFFF}
QHeaderView::section{background:#232326;color:#98989D;border:none;border-bottom:1px solid #3A3A3C;padding:8px;font-weight:600}
QComboBox,QLineEdit,QSpinBox,QDoubleSpinBox{background:#2C2C2E;border:1px solid #48484A;border-radius:8px;padding:6px 10px;color:#F2F2F7}
QComboBox:focus,QLineEdit:focus{border:1px solid #0A84FF}
QScrollBar:vertical{background:transparent;width:10px;margin:2px}
QScrollBar::handle:vertical{background:#48484A;border-radius:5px;min-height:30px}
QScrollBar::add-line,QScrollBar::sub-line{height:0}
QStatusBar{background:#2C2C2E;border-top:1px solid #3A3A3C;color:#98989D}
QProgressBar{border:1px solid #3A3A3C;border-radius:6px;background:#2C2C2E;text-align:center}
QProgressBar::chunk{background:#0A84FF;border-radius:5px}
#Toast{background:#FFFFFF;color:#1D1D1F;border-radius:10px;padding:10px 18px;font-weight:600;font-size:13px}
QTableWidget::item{padding:6px 8px}
QScrollArea{border:none;background:transparent}
